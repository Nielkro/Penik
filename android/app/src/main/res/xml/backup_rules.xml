<?xml version="1.0" encoding="utf-8"?>
<!--
    Pre-API-31 counterpart of data_extraction_rules.xml. allowBackup is already
    false in the manifest; these excludes keep the intent explicit if it is ever
    flipped on.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>

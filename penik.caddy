# ==============================================================================
# Penik Messenger — Caddy site config (/etc/caddy/sites-enabled/penik.caddy)
# ==============================================================================

# 1. Главный домен — Лендинг и загрузка APK
penik.ru {
    root * /opt/penik/landing
    file_server
    encode gzip zstd

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}

# 2. Веб-клиент мессенджера (SPA)
web.penik.ru {
    # Proxying API and WebSockets to the backend directly from web.penik.ru
    handle /api/* {
        reverse_proxy 127.0.0.1:8143 {
            header_up Host {host}
            header_up X-Real-IP {client_ip}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Static SPA and SPA routing
    handle {
        root * /opt/penik/client/dist
        try_files {path} /index.html
        file_server
        encode gzip zstd
    }

    # Cache static assets
    @static {
        path /assets/* /sw.js /favicon*
    }
    header @static Cache-Control "public, max-age=31536000, immutable"

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}

# 3. Backend API and WebSockets (reverse proxy to docker container at 127.0.0.1:8143)
api.penik.ru {
    # ---------------------------------------------------------------------------
    # Sticker static files — served directly from disk by Caddy, bypassing Go.
    # The Go server only handles metadata/import/install API endpoints.
    # Sticker files are written to disk during import; transcoding (webm→webp)
    # is triggered by the import handler before responding, so files always exist
    # by the time clients request them.
    # ---------------------------------------------------------------------------
    handle /api/v1/stickers/file/* {
        # Strip the API prefix so the remaining path matches the on-disk layout:
        #   /api/v1/stickers/file/{pack_id}/{filename}
        #   → /opt/penik/data/stickers/{pack_id}/{filename}
        uri strip_prefix /api/v1/stickers/file
        root * /opt/penik/data/stickers
        file_server {
            hide bundle.zip *.tmp_*
        }
        header Cache-Control "public, max-age=86400"
    }

    # Bundle ZIP — same idea: serve the pre-built bundle.zip directly from disk.
    # The Go import handler builds (and rebuilds) bundle.zip on disk, so Caddy
    # just hands it over as a static file without touching Go at all.
    handle /api/v1/stickers/pack/*/bundle.zip {
        # Path after stripping prefix: /{pack_id}/bundle.zip
        uri strip_prefix /api/v1/stickers/pack
        root * /opt/penik/data/stickers
        file_server
        header Cache-Control "public, max-age=86400"
    }

    # ---------------------------------------------------------------------------
    # Internal-only handler for X-Accel-Redirect (encrypted attachments).
    # Go validates the ACL and then sets X-Accel-Redirect: /static-internal/...
    # Caddy intercepts the header and serves the file from disk without another
    # round-trip through the Go process. This path must NOT be routable from the
    # outside — `internal` at site level blocks any direct external request.
    # On-disk layout: /opt/penik/data/upload/attachments/{id}.bin
    # Accel URI:      /static-internal/upload/attachments/{id}.bin
    # ---------------------------------------------------------------------------

    # `internal` is a site-level directive; it cannot be nested inside handle.
    # Placing it here blocks external clients from reaching /static-internal/*.
    internal /static-internal/*

    handle /static-internal/* {
        uri strip_prefix /static-internal
        root * /opt/penik/data
        file_server
    }

    # All other /api/* traffic → Go backend
    handle {
        reverse_proxy 127.0.0.1:8143 {
            header_up Host {host}
            header_up X-Real-IP {client_ip}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Max attachment upload size (250 MB)
    request_body {
        max_size 250MB
    }
}

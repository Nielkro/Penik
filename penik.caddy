# ==============================================================================
# Penik Messenger — Caddy site config (/etc/caddy/sites-enabled/penik.caddy)
# ==============================================================================

# 1. Главный домен — Лендинг и загрузка APK
penik.ru {
    root * /opt/penik/landing
    file_server
    encode gzip zstd

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}

# 2. Веб-клиент мессенджера (SPA)
web.penik.ru {
    root * /opt/penik/client/dist
    file_server
    encode gzip zstd

    # SPA fallback на index.html
    try_files {path} /index.html

    # Кэширование статических файлов
    @static {
        path /assets/* /sw.js /favicon*
    }
    header @static Cache-Control "public, max-age=31536000, immutable"

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}

# 3. Бэкенд API и WebSockets (проксирование в docker-контейнер на 127.0.0.1:8143)
api.penik.ru {
    reverse_proxy 127.0.0.1:8143 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # Максимальный размер вложений (250MB)
    request_body {
        max_size 250MB
    }
}
